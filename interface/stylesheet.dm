/client/script = {"<style>

@keyframes highlight-fade {
  0% {
    background-color: #ffff00; /* Bright yellow highlight */
  }
  100% {
    background-color: transparent; /* Fades out completely */
  }
}

.hfade {
  animation: highlight-fade 2s ease-out forwards; 
}

IMG.icon {width: 96px; height: 96px}
BIG IMG.icon {width: 256px; height: 256px}
SMALL IMG.icon {width: 96px; height: 96px}

</style>"}