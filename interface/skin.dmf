macro "macro"
	elem 
		name = "Tab"
		command = ".tab_panel"
	elem 
		name = "A+REP"
		command = ".west"
	elem 
		name = "D+REP"
		command = ".east"
	elem 
		name = "F"
		command = ".inhand"
	elem 
		name = "G"
		command = ".store"
	elem 
		name = "H"
		command = ".whistle"
	elem 
		name = "Q"
		command = ".drop"
	elem 
		name = "S+REP"
		command = ".south"
	elem 
		name = "T"
		command = ".speak"
	elem 
		name = "V"
		command = ".ragdoll"
	elem 
		name = "W+REP"
		command = ".north"
	elem 
		name = "Y"
		command = ".cmode"
	elem 
		name = "Subtract"
		command = ".speak"
	elem 
		name = "Divide"
		command = ".speak"
	elem 
		name = "F1"
		command = ".options"


menu "menu"
	elem 
		name = "&Prerequisites"
		command = ""
		saved-params = "is-checked"
	elem 
		name = "&Options and Messages...\tF1"
		command = ".options"
		category = "&Prerequisites"
		saved-params = "is-checked"
	elem 
		name = "&Quick screenshot\tF2"
		command = ".screenshot auto"
		category = "&Prerequisites"
		saved-params = "is-checked"
	elem 
		name = "&Save screenshot as...\tShift+F2"
		command = ".screenshot"
		category = "&Prerequisites"
		saved-params = "is-checked"
	elem 
		name = "&Quit"
		command = ".quit"
		category = "&Prerequisites"
		saved-params = "is-checked"
	elem 
		name = "&Drawing"
		command = ""
		saved-params = "is-checked"
	elem "stretch"
		name = "&Stretch to fit"
		command = ".winset \"mapwindow.map.icon-size=0\""
		category = "&Drawing"
		is-checked = true
		can-check = true
		group = "size"
		saved-params = "is-checked"
	elem "icon32"
		name = "&32x32"
		command = ".winset \"mapwindow.map.icon-size=32\""
		category = "&Drawing"
		can-check = true
		group = "size"
		saved-params = "is-checked"
	elem "icon16"
		name = "&16x16"
		command = ".winset \"mapwindow.map.icon-size=16\""
		category = "&Drawing"
		can-check = true
		group = "size"
		saved-params = "is-checked"
	elem "textmode"
		name = "&Text (UNSUPPORTED)"
		command = ".winset \"menu.textmode.is-checked=true?mapwindow.map.text-mode=true:mapwindow.map.text-mode=false\""
		category = "&Drawing"
		can-check = true
		saved-params = "is-checked"
	elem 
		name = "&Legal"
		command = ""
		saved-params = "is-checked"
	elem 
		name = "&License"
		command = ".license"
		category = "&Legal"
		saved-params = "is-checked"
	elem 
		name = "&About"
		command = ".about"
		category = "&Legal"
		saved-params = "is-checked"


window "mainwindow"
	elem "mainwindow"
		type = MAIN
		pos = 281,0
		size = 640x440
		anchor1 = -1,-1
		anchor2 = -1,-1
		is-default = true
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "Fringe Sector: Roguestation Endera"
		statusbar = false
		is-maximized = true
		icon = 'interface\\roguespace.png'
		macro = "macro"
		menu = "menu"
	elem "mainvsplit"
		type = CHILD
		pos = 0,0
		size = 640x440
		anchor1 = 0,0
		anchor2 = 100,100
		saved-params = "splitter"
		right = "rpane"
		is-vert = true

window "mapwindow"
	elem "mapwindow"
		type = MAIN
		pos = 384,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		titlebar = false
		statusbar = false
		can-close = false
		can-minimize = false
		can-resize = false
		is-pane = true
	elem "map"
		type = MAP
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		text-color = #000000
		is-default = true
		saved-params = "icon-size"
		on-show = ".winset\"mainwindow.mainvsplit.left=mapwindow\""
		on-hide = ".winset\"mainwindow.mainvsplit.left=\""

window "outputwindow"
	elem "outputwindow"
		type = MAIN
		pos = 384,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		titlebar = false
		statusbar = false
		can-close = false
		can-minimize = false
		can-resize = false
		is-pane = true
	elem "output"
		type = OUTPUT
		pos = 0,0
		size = 640x480
		anchor1 = 0,0
		anchor2 = 100,100
		text-color = #ffffff
		background-color = #000000
		is-default = true
		saved-params = "max-lines"
		style = ".system {color:#ff0000;}\n\n@keyframes highlight-fade {\n  0% {\n    background-color: #ffff00;\n  }\n  100% {\n    background-color: transparent;\n  }\n}\n\n.hfade {\n  animation: highlight-fade 2s ease-out forwards; \n}"
		enable-http-images = true

window "rpane"
	elem "rpane"
		type = MAIN
		pos = 384,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		background-color = #000000
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "rpanewindow"
		type = CHILD
		pos = 0,0
		size = 640x502
		anchor1 = 0,0
		anchor2 = 100,100
		background-color = #000000
		saved-params = "splitter"
		right = "outputwindow"
		is-vert = false
	elem "textb"
		type = BUTTON
		pos = 0,0
		size = 60x20
		anchor1 = -1,-1
		anchor2 = -1,-1
		text-color = #a4a4a2
		background-color = #3a3a3a
		is-visible = false
		saved-params = "is-checked"
		text = "TXT-MOD"
		command = ".winset \"rpanewindow.left=;\""
		is-checked = true
		group = "rpanemode"
		button-type = pushbox
	elem "infob"
		type = BUTTON
		pos = 64,0
		size = 80x20
		anchor1 = -1,-1
		anchor2 = -1,-1
		text-color = #a4a4a2
		background-color = #3a3a3a
		is-visible = false
		saved-params = "is-checked"
		text = "CHAR-PANEL"
		command = ".winset \"rpanewindow.left=infowindow\""
		group = "rpanemode"
		button-type = pushbox

window "infowindow"
	elem "infowindow"
		type = MAIN
		pos = 384,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		border = sunken
		saved-params = "pos;size;is-minimized;is-maximized"
		title = "Info"
		is-pane = true
	elem "info"
		type = INFO
		pos = 0,0
		size = 640x502
		anchor1 = 0,0
		anchor2 = 100,100
		font-family = "System"
		text-color = #a4a4a2
		background-color = #000000
		is-default = true
		border = sunken
		saved-params = ""
		tab-text-color = #a4a4a2
		tab-background-color = #3a3a3a
		tab-font-family = "monospace"
		tab-font-size = 15
		on-show = ".winset\"rpane.infob.is-visible=true;rpane.infob.pos=130,0:rpane.infob.pos=65,0 rpane.textb.is-visible=true rpane.infob.is-checked=true rpane.rpanewindow.pos=0,30 rpane.rpanewindow.size=0x0 rpane.rpanewindow.left=infowindow\""
		on-hide = ".winset\"rpane.infob.is-visible=false;rpane.rpanewindow.left=browserwindow:rpane.textb.is-visible=false rpane.rpanewindow.pos=0,0 rpane.rpanewindow.size=0x0 rpane.rpanewindow.left=\""

