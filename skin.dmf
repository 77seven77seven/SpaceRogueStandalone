window "rpane"
	elem "rpane"
		type = MAIN
		pos = 384,0
		size = 640x480
		anchor1 = -1,-1
		anchor2 = -1,-1
		saved-params = "pos;size;is-minimized;is-maximized"
		is-pane = true
	elem "rpanewindow"
		type = CHILD
		pos = 0,0
		size = 640x502
		anchor1 = 0,0
		anchor2 = 100,100
