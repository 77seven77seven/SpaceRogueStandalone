	"version": "0.2.0",
	"configurations": [
	
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamSeeker",
			"preLaunchTask": "Build Debug DMB",
			"dmb": "${workspaceFolder}/SpaceRogueStandalone.dmb",
			"args": ["-debug"]
		},
		{
			"type": "byond",
			"request": "launch",
			"name": "Launch DreamDaemon",
			"preLaunchTask": "Build Debug DMB",
			"dmb": "${workspaceFolder}/SpaceRogueStandalone.dmb",
			"dreamDaemon": true,
			"args": ["-debug"]
		}
	]
}